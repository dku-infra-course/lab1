#cloud-config
# W5 캐시 서버 사전 상태
#   - 기본값(preinstall_conf = false)이면 아무 패키지도 설치하지 않는다. 학생이
#     콘솔로 직접 만드는 순정 Ubuntu VM과 조건을 맞추기 위한 것이다.
#   - preinstall_conf = true 면 Nginx/Squid 설치와 캐시 존·리버스 프록시 설정·
#     Squid cache_dir 배치까지 마친다.
#
# 백엔드(Flask) 서버 IP (참고): ${webserver_ip}
password: ${vm_password}
chpasswd:
  expire: false
ssh_pwauth: true
%{ if length(extra_ssh_authorized_keys) > 0 }
ssh_authorized_keys:
%{ for k in extra_ssh_authorized_keys }
  - ${k}
%{ endfor }
%{ endif }

%{ if preinstall_conf }
package_update: true
packages:
  - nginx
  - squid
  - curl
%{ endif }

write_files:
  - path: /etc/dku-lab-role
    permissions: '0644'
    content: |
      cache
  - path: /etc/dku-lab-backends
    permissions: '0644'
    content: |
      webserver=${webserver_ip}
%{ if preinstall_conf }
  - path: /etc/nginx/conf.d/api-cache-zone.conf
    permissions: '0644'
    encoding: b64
    content: ${base64encode(nginx_cache_zone)}
  - path: /etc/nginx/sites-available/backend-proxy
    permissions: '0644'
    encoding: b64
    content: ${base64encode(nginx_cache_conf)}
  - path: /etc/squid/conf.d/dku-lab-cache-dir.conf
    permissions: '0644'
    encoding: b64
    content: ${base64encode(squid_snippet)}
%{ endif }

%{ if preinstall_conf }
runcmd:
  - systemctl enable --now nginx
  - systemctl enable --now squid
  - mkdir -p /var/cache/nginx/api_cache
  - ln -sf /etc/nginx/sites-available/backend-proxy /etc/nginx/sites-enabled/backend-proxy
  - rm -f /etc/nginx/sites-enabled/default
  - nginx -t
  - systemctl reload nginx
  - systemctl stop squid
  - rm -rf /var/spool/squid/*
  - squid -z
  - sleep 3
  - systemctl start squid
  - systemctl is-active nginx || true
  - systemctl is-active squid || true
%{ endif }
