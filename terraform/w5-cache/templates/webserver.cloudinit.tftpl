#cloud-config
# W5 백엔드 서버 사전 상태
#   - 기본값(preinstall_app = false)이면 아무 패키지도 설치하지 않는다. 학생이
#     콘솔로 직접 만드는 순정 Ubuntu VM과 조건을 맞추기 위한 것이다.
#   - preinstall_app = true 면 Python/Flask/Redis 클라이언트/Redis 서버 설치와
#     앱 코드(app.py) 배치·기동까지 마친다. Redis 보안 설정(requirepass)은
#     redis_password 를 함께 넣어야 적용된다.
password: ${vm_password}
chpasswd:
  expire: false
ssh_pwauth: true
%{ if length(extra_ssh_authorized_keys) > 0 }
ssh_authorized_keys:
%{ for k in extra_ssh_authorized_keys }
  - ${k}
%{ endfor }
%{ endif }

%{ if preinstall_app }
package_update: true
packages:
  - python3-pip
  - python3-flask
  - python3-redis
  - redis-server
  - curl
%{ endif }

write_files:
  - path: /etc/dku-lab-role
    permissions: '0644'
    content: |
      webserver
%{ if preinstall_app }
%{ if set_redis_pass }
  - path: /etc/redis/dku-lab-extra.conf
    permissions: '0640'
    encoding: b64
    content: ${base64encode(redis_extra_conf)}
%{ endif }
  - path: /home/ubuntu/backend-app/app.py
    owner: 'ubuntu:ubuntu'
    permissions: '0644'
    encoding: b64
    content: ${base64encode(app_py)}
  - path: /etc/systemd/system/backend-app.service
    permissions: '0644'
    encoding: b64
    content: ${base64encode(backend_service_unit)}
%{ endif }

%{ if preinstall_app }
runcmd:
  - systemctl enable --now redis-server
%{ if set_redis_pass }
  - grep -q '^requirepass ' /etc/redis/redis.conf || cat /etc/redis/dku-lab-extra.conf >> /etc/redis/redis.conf
  - chown redis:redis /etc/redis/redis.conf
  - systemctl restart redis-server
%{ endif }
  - chown -R ubuntu:ubuntu /home/ubuntu/backend-app
  - systemctl daemon-reload
  - systemctl enable --now backend-app
  - systemctl is-active redis-server || true
%{ endif }
